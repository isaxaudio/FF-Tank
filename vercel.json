{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cron-exec-movement.js": {
      "maxDuration": 300
    },
    "api/cron-scout.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-exec-movement",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron-scout",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/oauth/gmail",
      "destination": "/api/index?service=gmail-auth"
    },
    {
      "source": "/u/:token",
      "destination": "/api/index?service=unsubscribe&t=:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
